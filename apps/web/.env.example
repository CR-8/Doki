# Copy to .env and fill in. Never commit .env — it holds live credentials.
#
# Anything here is a fallback. A workspace that has connected its own account
# under Settings → Telephony uses that instead, so these values only apply to
# workspaces with nothing configured.

# ---- Auth ----
# Root secret. Also derives the key that encrypts stored provider credentials,
# so rotating it makes saved telephony tokens unreadable and they must be
# re-entered. At least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ---- Database ----
# Neon pooled connection. DIRECT is the unpooled one, used by migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Public URL of the deployment. Twilio fetches TwiML and audio from here, so
# localhost will not work for real calls — use a tunnel or the deployed URL.
APP_URL=http://localhost:3001

# ---- LLM (post-call analysis) ----
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# ---- Voice ----
# mock | twilio | vapi. mock dials nothing and is refused in production.
VOICE_PROVIDER=mock

VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_PHONE_NUMBER_ID=

# Twilio. TWILIO_FROM_NUMBER must be a number the account owns or an outside
# number verified as an outgoing caller ID — Twilio rejects anything else.
# Check with: cd packages/api && bun run verify:twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_RECORD=true

# ---- Speech (Sarvam) ----
SARVAM_API_KEY=
SARVAM_STT_MODEL=
# bulbul:v2 is retired. v3 uses an entirely different speaker roster —
# see packages/connectors/src/tts/voices.ts, or the Voice picker on an agent.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# ---- Cost attribution, in INR per minute ----
COST_TELEPHONY_INR_PER_MIN=
COST_STT_INR_PER_MIN=
COST_PLATFORM_INR_PER_MIN=

# ---- Follow-up runner ----
# Shared secret for the cron endpoint. Optional; the console drains follow-ups
# on its own while someone has it open.
CRON_SECRET=

# ---- Cache (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
