{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"NODE_ENV",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_URL",
		"AWS_LAMBDA_FUNCTION_NAME",
		"SKIP_ENV_VALIDATION"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"],
			"env": [
				"DATABASE_URL",
				"DATABASE_URL_DIRECT",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"APP_URL",
				"CRON_SECRET",
				"LLM_PROVIDER",
				"LLM_MODEL",
				"OPENAI_API_KEY",
				"VOICE_PROVIDER",
				"VAPI_API_KEY",
				"VAPI_WEBHOOK_SECRET",
				"VAPI_PHONE_NUMBER_ID",
				"TWILIO_ACCOUNT_SID",
				"TWILIO_AUTH_TOKEN",
				"TWILIO_FROM_NUMBER",
				"TWILIO_RECORD",
				"SARVAM_API_KEY",
				"SARVAM_STT_MODEL",
				"SARVAM_TTS_MODEL",
				"SARVAM_TTS_SPEAKER",
				"COST_TELEPHONY_INR_PER_MIN",
				"COST_STT_INR_PER_MIN",
				"COST_TTS_INR_PER_10K_CHARS",
				"COST_LLM_INR_PER_1K_INPUT",
				"COST_LLM_INR_PER_1K_OUTPUT",
				"COST_PLATFORM_INR_PER_MIN"
			]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"env": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
		},
		"db:generate": {
			"cache": false,
			"interactive": true,
			"env": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true,
			"env": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"env": ["DATABASE_URL", "DATABASE_URL_DIRECT"]
		}
	}
}
