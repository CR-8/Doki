{
	"name": "doki",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/node": "^26.2.0",
			"next": "^16.3.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@orpc/server": "^1.14.12",
			"@orpc/client": "^1.14.12",
			"@orpc/openapi": "^1.14.12",
			"@orpc/zod": "^1.14.12",
			"better-auth": "1.7.1",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"db:push": "turbo run db:push -F @doki/db --",
		"db:studio": "turbo run db:studio -F @doki/db --",
		"db:generate": "turbo run db:generate -F @doki/db --",
		"db:migrate": "turbo run db:migrate -F @doki/db --",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@doki/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@doki/config": "workspace:*",
		"@types/node": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.14"
}
