{
	"name": "@doki/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./schema": {
			"default": "./src/schema/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate:deploy": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"check-types": "tsc --noEmit",
		"db:check": "bun run test/connection.check.ts"
	},
	"dependencies": {
		"@doki/env": "workspace:*",
		"@neondatabase/serverless": "^1.1.0",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@doki/config": "workspace:*",
		"drizzle-kit": "^0.31.10",
		"typescript": "catalog:"
	}
}
