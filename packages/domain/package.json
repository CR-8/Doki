{
	"name": "@doki/domain",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"verify": "bun run test/policy.check.ts && bun run test/import.check.ts",
		"verify:followups": "bun run test/followups.check.ts",
		"verify:db": "bun run test/followups.check.ts && bun run test/import-commit.check.ts"
	},
	"dependencies": {
		"@doki/db": "workspace:*",
		"@doki/env": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"libphonenumber-js": "^1.11.19",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@doki/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
